#!/usr/bin/python3
# Imprimerie 2.4 — serveur de génération de devis PDF (paquet « imprimerie »).
import http.server, os, pwd

FORMAT = os.environ.get("IMPRIMERIE_FORMAT", "Lettre")
PORT = int(os.environ.get("IMPRIMERIE_PORT", "8100"))

class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        body = f"imprimerie 2.4 format={FORMAT} utilisateur={pwd.getpwuid(os.getuid()).pw_name}\n".encode()
        self.send_response(200)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

print(f"imprimerie prête, format {FORMAT}", flush=True)
http.server.HTTPServer(("127.0.0.1", PORT), Handler).serve_forever()
